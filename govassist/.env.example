# GovAssist — environment variables
#
# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's already in .gitignore.
#
# Run `npm run check-env` after filling this in to verify it's wired up
# correctly before starting the dev server.

# --- Required: Supabase (auth + database) ---
# Project Settings → API in your Supabase dashboard.
# The anon key is safe to expose to the browser — every table it can reach
# is still gated by the row-level security policies in
# supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only: elevated privileges, NEVER prefix with NEXT_PUBLIC_ ---
# Required for: privileged scripts (e.g. scripts/seed-exams.example.ts) AND,
# as of Phase 5.5, the official-update monitoring pipeline itself
# (lib/source-monitoring/, the /api/cron/check-sources route, and admin
# review actions) — all real, running code now, not just scripts. The
# `server-only` import in lib/supabase/admin.ts makes it a build error to
# accidentally import it from a Client Component, but it's still worth
# being deliberate: this key bypasses every RLS policy.
SUPABASE_SERVICE_ROLE_KEY=

# --- Server-only: required for the source-monitoring cron endpoint ---
# A random secret of your own choosing (e.g. `openssl rand -hex 32`) — set
# the SAME value here and in your Vercel project's environment variables.
# Vercel automatically sends it as `Authorization: Bearer <value>` when
# triggering the scheduled job configured in vercel.json; the route at
# app/api/cron/check-sources/route.ts refuses every request without it —
# there's no unauthenticated fallback.
CRON_SECRET=

# --- Optional ---
# Your deployed origin, used to build the redirect links inside auth emails
# (signup confirmation, password reset). Falls back to the request's own
# host header if unset, which is fine for local dev.
# NEXT_PUBLIC_SITE_URL=https://govassist.app

# --- Optional: email notifications (Phase 14) ---
# Email is OFF until both RESEND_API_KEY and EMAIL_FROM are set, and even then
# only goes to users who switched "Also email me" on in Settings. In-app
# notifications work without any of this.
# RESEND_API_KEY=            # from resend.com (server-only, never NEXT_PUBLIC_)
# EMAIL_FROM="GovAssist <alerts@your-verified-domain.in>"
# Needed to mark an email "delivered": in Resend, add a webhook to
# https://<your-domain>/api/webhooks/resend for email.delivered, email.bounced
# and email.complained, then paste its signing secret here. Without it, emails
# stay at "sent" (accepted by the provider) and are never shown as delivered.
# RESEND_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_SITE_URL (above) is also used to build links inside emails.

# --- Future (not yet used) ---
# OCR extraction is NOT connected (lib/ocr/extract.ts returns blank fields for
# the user to fill in) — no provider key is called yet. Set OCR_PROVIDER_API_KEY or ANTHROPIC_API_KEY here once
# a real provider is wired in; see the comment at the top of that file for
# exactly what needs to change.
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# OCR_PROVIDER_API_KEY=
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=
